modules = ["python-3.11"]
[nix]
channel = "stable-25_05"
packages = ["cargo", "ffmpeg-full", "libev", "libiconv", "libxcrypt", "redis", "rustc", "unzip"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
REDIS_BROKER_URL = "redis://localhost:6379/0"
REDIS_HOST = "localhost"
REDIS_PORT = "6379"
DB_MIN_CONN = "1"
DB_MAX_CONN = "10"
PORT = "5000"
CADASTRO_TOKENS = "abc123,def456,xyz789"
temperatura = "0.3"
language = "pt"
