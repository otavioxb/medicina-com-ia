modules = ["python-3.11", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["cargo", "ffmpeg-full", "libev", "libiconv", "libxcrypt", "redis", "rustc", "unzip"]

[agent]
expertMode = true
integrations = ["github:1.0.0"]

[userenv]

[userenv.shared]
REDIS_BROKER_URL = "redis://localhost:6379/0"
REDIS_HOST = "localhost"
REDIS_PORT = "6379"
DB_MIN_CONN = "1"
DB_MAX_CONN = "10"
PORT = "5000"
CADASTRO_TOKENS = "abc123,def456,xyz789"
temperatura = "0.3"
language = "pt"

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "redis-server --daemonize yes --dir /tmp --port 6379 --save \"\" 2>/dev/null; sleep 1; cd /home/runner/workspace/medicina_com_ia && python -m uvicorn app.main:app --host 0.0.0.0 --port 5000 --reload"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
